# Configuración del servidor y base de datos (Ejemplo)
# Cópia este archivo como .env y coloca tus credenciales reales

# Google Places API Key para scripts de mantenimiento (opcional)
GOOGLE_PLACES_API_KEY=tu_api_key_aqui

# Conexión a base de datos de MongoDB Atlas (si se omite, el backend usará el modo fallback local)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
